# Claude Max Configuration - Primary AI Models
CLAUDE_AUTH_METHOD=claude-max
USE_CLAUDE_MAX_SUBSCRIPTION=true
API_KEY_REQUIRED=false
PRIMARY_MODEL=claude-opus-4.1
SECONDARY_MODEL=claude-sonnet-4
USE_BROWSER_SESSION=true
AUTO_DETECT_SUBSCRIPTION=true
USE_ONLY_CLAUDE=true
DISABLE_OTHER_MODELS=true
MODEL_TEMPERATURE_OPUS=0.7
MODEL_TEMPERATURE_SONNET=0.5

# Legacy models (disabled for Claude Max workflow)
# OPENAI_API_KEY="sk-12719cafdb964c3493434fac20a5679e"
# OPENAI_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
# OPENAI_MODEL="qwen3-coder-plus-2025-07-22"

# OllamaMax Configuration
PROJECT_NAME=ollamamax
PROJECT_PATH=./ollamamax
STACK_TYPE=full-stack
VERIFICATION_MODE=strict
AUTO_DETECT_STACK=true

# Development Configuration
NODE_ENV=development
GO_ENV=development
POSTGRES_URL=postgresql://localhost:5432/ollamamax_dev
REDIS_URL=redis://localhost:6379

# Testing Configuration
PLAYWRIGHT_ENABLED=true
SERENA_ENABLED=true
TEST_COVERAGE_TARGET=95
PARALLEL_TESTING=true

# Production Configuration
PRODUCTION_READY=true
SECURITY_HARDENING=enabled
MONITORING_ENABLED=true
PERFORMANCE_OPTIMIZATION=enabled
