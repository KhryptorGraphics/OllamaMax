# OllamaMax Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=3000
HOST=localhost
LOG_LEVEL=info

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-secret-session-key-here-32-chars-minimum
JWT_SECRET_KEY=your-secret-key-change-this-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-for-aes256

# Authentication settings
AUTH_ENABLED=true

# CORS Settings
CORS_ORIGIN=https://yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database Settings
# Note: When running in Docker, use service names (postgres) for host
# When running locally, use localhost or IP addresses
DB_HOST=postgres
DB_PORT=15432
DB_NAME=ollamamax
DB_USER=ollama
DB_PASSWORD=secure_password
DB_SSL_MODE=prefer

# PostgreSQL Connection Pool Settings (optional)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis Cache Settings
# Note: When running in Docker, use service names (redis) for host
# When running locally, use localhost or IP addresses
REDIS_HOST=redis
REDIS_PORT=16379
REDIS_PASSWORD=secure_redis_password
REDIS_DB=0

# Redis Connection Pool Settings (optional)
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# =============================================================================
# API KEYS AND EXTERNAL SERVICES
# =============================================================================
# OpenAI API (if using OpenAI integration)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API (if using Claude integration)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Hugging Face API (if using HF models)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# GitHub Integration (optional)
GITHUB_TOKEN=your-github-personal-access-token

# Email Service (for notifications)
SMTP_HOST=smtp.youremailprovider.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-email-password

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_TIMEOUT=300000
OLLAMA_MAX_CONCURRENT_REQUESTS=5
OLLAMA_DEFAULT_MODEL=llama2

# Model Management
OLLAMA_MODELS_PATH=/var/lib/ollama/models
OLLAMA_CACHE_SIZE=10GB
OLLAMA_GPU_ENABLED=true

# =============================================================================
# DISTRIBUTED INFERENCE SETTINGS
# =============================================================================
CLUSTER_NODE_ID=node-1
CLUSTER_DISCOVERY_MODE=static
CLUSTER_NODES=http://localhost:11434,http://node2:11434
LOAD_BALANCER_STRATEGY=round-robin

# Service Discovery
CONSUL_URL=http://localhost:8500
ETCD_ENDPOINTS=http://localhost:2379

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================
# Metrics
PROMETHEUS_PORT=19090
GRAFANA_URL=http://localhost:13000

# Logging
LOG_FILE_PATH=/var/log/ollamamax/app.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10

# Health Checks
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# FILE STORAGE
# =============================================================================
# Local Storage
UPLOAD_PATH=/var/lib/ollamamax/uploads
UPLOAD_MAX_SIZE=100MB
UPLOAD_ALLOWED_TYPES=.txt,.json,.csv,.md

# S3 Compatible Storage (optional)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET_NAME=ollamamax-storage
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_REGION=us-west-2

# =============================================================================
# DEVELOPMENT SETTINGS (only for development)
# =============================================================================
# Enable debug logging in development
DEBUG=ollamamax:*

# Hot reload settings
WATCH_FILES=true

# =============================================================================
# TEST ENVIRONMENT VARIABLES
# =============================================================================
# API Keys for testing (used in test files)
TEST_API_KEY=test-api-key-for-testing
TEST_JWT_SECRET=test-jwt-secret-32-chars-minimum-for-testing
RESTART_ON_CHANGE=true

# Test database (for running tests)
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:15432/ollamamax_test

# =============================================================================
# LOCAL DEVELOPMENT OVERRIDES
# =============================================================================
# When running the application locally (outside Docker), use these settings:
# 
# DB_HOST=localhost
# DB_PORT=15432          # External port mapping from docker-compose
# REDIS_HOST=localhost
# REDIS_PORT=16379       # External port mapping from docker-compose
#
# Port Mappings from docker-compose.yml:
# - PostgreSQL: 15432:15432 (external:internal)
# - Redis: 16379:16379 (external:internal) 
# - API: 11434:11434
# - P2P: 11435:11435
# - Admin: 11436:11436
# - HTTP: 10080:10080
# - HTTPS: 10443:10443
# - Prometheus: 19090:19090
# - Grafana: 13000:13000

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
# 1. Never commit this file with real values to version control
# 2. Use different secrets for each environment (dev, staging, prod)
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use strong, randomly generated passwords (32+ characters)
# 5. Enable 2FA on all external services
# 6. Restrict database access to specific IP addresses
# 7. Use SSL/TLS for all connections
# 8. Monitor for unauthorized access attempts
# 9. Keep all dependencies updated
# 10. Regular security audits and penetration testing

# =============================================================================
# QUICK SETUP COMMANDS
# =============================================================================
# Generate session secret: openssl rand -hex 32
# Generate JWT secret: openssl rand -base64 64
# Generate encryption key: openssl rand -hex 32
# Test database connection: npm run db:test
# Run security audit: npm audit
# Check for vulnerable dependencies: npm audit --audit-level moderate