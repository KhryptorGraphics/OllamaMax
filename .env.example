# OllamaMax Environment Configuration
# Copy this file to .env and update the values for your environment

# Application Settings
NODE_ENV=production
PORT=13100
API_PORT=13100
WEB_PORT=3000

# Security - CRITICAL: Change these values in production!
# JWT_SECRET must be at least 32 characters for HS256 security
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_32_CHAR_JWT_SECRET_HERE_PRODUCTION_ONLY!
# JWT_SECRET_KEY is used by Go backend - must match JWT_SECRET
JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_32_CHAR_JWT_SECRET_HERE_PRODUCTION_ONLY!
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Database Configuration
DB_TYPE=postgres
SQLITE_DB_PATH=/app/data/users.db

# PostgreSQL Configuration (Production)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ollamamax
POSTGRES_USER=ollama
POSTGRES_PASSWORD=secure_password_change_this

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ollama_redis_pass_change_this

# Email Configuration - SECURITY: Use app passwords for Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=CHANGE_ME_USE_APP_PASSWORD_NOT_ACCOUNT_PASSWORD
SMTP_FROM=noreply@yourdomain.com

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_password_change_this

# Ollama Configuration
OLLAMA_PRIMARY_HOST=ollama-primary
OLLAMA_PRIMARY_PORT=11434
OLLAMA_WORKER_1_HOST=ollama-worker-1
OLLAMA_WORKER_1_PORT=11434
OLLAMA_WORKER_2_HOST=ollama-worker-2
OLLAMA_WORKER_2_PORT=11434

# Load Balancing
LOAD_BALANCER_ALGORITHM=round_robin
HEALTH_CHECK_INTERVAL=30
MAX_RETRIES=3
TIMEOUT_MS=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# File Upload
MAX_FILE_SIZE=10MB
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=txt,md,json,yaml,yml

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined
ACCESS_LOG_PATH=/app/logs/access.log
ERROR_LOG_PATH=/app/logs/error.log

# SSL/TLS (for production)
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# CORS Configuration - SECURITY: Restrict origins in production
# WARNING: * allows all origins - specify exact domains for production
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_CREDENTIALS=true

# Session Configuration
SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_32_CHAR_SESSION_SECRET_HERE!
SESSION_MAX_AGE=3600000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Development Settings (set to false in production)
DEBUG_MODE=false
VERBOSE_LOGGING=false
ENABLE_SWAGGER=false

# Development Mode Features
ENABLE_MOCK_NODES=true
MOCK_NODES_COUNT=3
AUTO_VERIFY_EMAIL=true

# Ollama Node Discovery
ENABLE_OLLAMA_DISCOVERY=true
ENABLE_LOCAL_OLLAMA=false
# Comma-separated list of Ollama node URLs
OLLAMA_NODES=http://ollama-node-1:11434,http://ollama-node-2:11434
# Or use individual variables (OLLAMA_NODE_1, OLLAMA_NODE_2, etc.)

# ============================================================================
# DISTRIBUTED TRACING & OBSERVABILITY
# ============================================================================

# Jaeger Tracing Configuration
# Jaeger provides distributed tracing for microservices and API request tracking
# SECURITY: Ensure Jaeger endpoint is not publicly exposed
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
JAEGER_SAMPLER_TYPE=const
# JAEGER_SAMPLER_PARAM: 1.0 = trace all requests, 0.0 = trace none (adjust for production load)
JAEGER_SAMPLER_PARAM=1.0
JAEGER_SERVICE_NAME=ollamamax-api
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# ELK Stack Configuration
# Elasticsearch, Logstash, Kibana for centralized log aggregation and analysis
# SECURITY: Set strong credentials for production deployments
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
# Leave blank for development, set secure credentials in production
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5044
KIBANA_HOST=kibana
KIBANA_PORT=5601

# ============================================================================
# ALERT NOTIFICATION CHANNELS
# ============================================================================

# Slack Integration
# SECURITY: Protect webhook URLs - they provide write access to your Slack workspace
# Generate webhooks at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
# Channel for critical alerts (P0/P1 incidents, system failures)
SLACK_CHANNEL_CRITICAL=#ollamamax-critical
# Channel for warning alerts (performance degradation, high resource usage)
SLACK_CHANNEL_WARNING=#ollamamax-warnings
# Channel for P2P network alerts (node failures, consensus issues)
SLACK_CHANNEL_P2P=#ollamamax-p2p

# Email Alerts
# Configure email addresses for different alert severity levels
# SECURITY: Use dedicated monitoring email addresses, not personal accounts
ALERT_EMAIL_CRITICAL=admin@ollamamax.local
ALERT_EMAIL_WARNING=monitoring@ollamamax.local
ALERT_EMAIL_P2P=p2p@ollamamax.local

# PagerDuty Integration
# For on-call rotation and incident escalation
# SECURITY: Protect service keys - they can trigger alerts and incidents
# Generate keys at: https://support.pagerduty.com/docs/services-and-integrations
PAGERDUTY_SERVICE_KEY=YOUR_PAGERDUTY_SERVICE_KEY_HERE
PAGERDUTY_INTEGRATION_URL=https://events.pagerduty.com/v2/enqueue

# ============================================================================
# MONITORING FEATURE FLAGS
# ============================================================================

# Monitoring Configuration
# Enable/disable monitoring features globally
# NOTE: Disabling may impact observability in production
METRICS_ENABLED=true
TRACING_ENABLED=true
LOG_AGGREGATION_ENABLED=true

# Alert Thresholds (optional - can be configured in monitoring/alerts.yml)
# CPU_ALERT_THRESHOLD=80
# MEMORY_ALERT_THRESHOLD=85
# DISK_ALERT_THRESHOLD=90
# ERROR_RATE_THRESHOLD=5
# RESPONSE_TIME_P95_THRESHOLD=1000

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Slack Webhook URLs: Treat as secrets - never commit to version control
# 2. PagerDuty Keys: Rotate regularly and restrict access to authorized personnel
# 3. ELK Credentials: Use strong passwords and enable SSL/TLS for production
# 4. Jaeger Endpoint: Ensure network isolation and authentication in production
# 5. Email Credentials: Use SMTP authentication and app-specific passwords
# 6. Channel Names: Ensure Slack channels exist before configuring alerts
# 7. Alert Fatigue: Tune thresholds to avoid excessive notifications
# 8. Data Privacy: Be mindful of PII in logs sent to external services
