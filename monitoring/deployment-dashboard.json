{
  "dashboard": {
    "title": "Deployment Monitoring Dashboard",
    "tags": ["deployment", "monitoring", "production"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Deployment Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "deployment_status{environment=\"production\"}",
            "legendFormat": "Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "1", "text": "✅ SUCCESS"},
              {"type": "value", "value": "0", "text": "❌ FAILED"},
              {"type": "value", "value": "0.5", "text": "⚠️ IN PROGRESS"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 0.5},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Deployment Duration",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "deployment_duration_seconds{environment=\"production\"}",
            "legendFormat": "Duration"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 0
          }
        }
      },
      {
        "id": 3,
        "title": "Service Health",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "up{job=~\"ollama.*|api|web|postgres|redis\"}",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "indexByName": {"job": 0, "Value": 1},
              "renameByName": {"job": "Service", "Value": "Status"}
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Status"},
              "properties": [
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-text",
                    "mode": "gradient"
                  }
                },
                {
                  "id": "mappings",
                  "value": [
                    {"type": "value", "value": "1", "text": "✅ UP"},
                    {"type": "value", "value": "0", "text": "❌ DOWN"}
                  ]
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {"color": "red", "value": 0},
                      {"color": "green", "value": 1}
                    ]
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": 4,
        "title": "CPU Usage by Service",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total{job=~\"ollama.*|api|web\"}[5m]) * 100",
            "legendFormat": "{{job}}"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "CPU %"},
          {"format": "short"}
        ],
        "legend": {"show": true, "alignAsTable": true, "rightSide": false}
      },
      {
        "id": 5,
        "title": "Memory Usage by Service",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=~\"ollama.*|api|web\"} / 1024 / 1024",
            "legendFormat": "{{job}}"
          }
        ],
        "yaxes": [
          {"format": "mbytes", "label": "Memory"},
          {"format": "short"}
        ],
        "legend": {"show": true, "alignAsTable": true, "rightSide": false}
      },
      {
        "id": 6,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"api\"}[5m])",
            "legendFormat": "{{method}} {{path}}"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ],
        "legend": {"show": true, "alignAsTable": true, "rightSide": false}
      },
      {
        "id": 7,
        "title": "Response Time (P50, P95, P99)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"api\"}[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"api\"}[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"api\"}[5m]))",
            "legendFormat": "P99"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Response Time"},
          {"format": "short"}
        ],
        "thresholds": [
          {"value": 0.2, "colorMode": "custom", "fill": false, "line": true, "op": "gt", "lineColor": "yellow"},
          {"value": 0.5, "colorMode": "custom", "fill": false, "line": true, "op": "gt", "lineColor": "red"}
        ]
      },
      {
        "id": 8,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"api\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"api\"}[5m]) * 100",
            "legendFormat": "5xx Error Rate"
          },
          {
            "expr": "rate(http_requests_total{job=\"api\",status=~\"4..\"}[5m]) / rate(http_requests_total{job=\"api\"}[5m]) * 100",
            "legendFormat": "4xx Error Rate"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "Error Rate %"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [5], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "name": "High Error Rate"
        }
      },
      {
        "id": 9,
        "title": "Pod Count by Deployment",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "expr": "kube_deployment_status_replicas{namespace=~\"ollamamax.*\"}",
            "legendFormat": "{{deployment}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Replicas"},
          {"format": "short"}
        ],
        "legend": {"show": true, "alignAsTable": true, "rightSide": false}
      },
      {
        "id": 10,
        "title": "Auto-Scaling Events",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "changes(kube_deployment_status_replicas{namespace=~\"ollamamax.*\"}[1h])",
            "legendFormat": "{{deployment}} scaling events"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Events"},
          {"format": "short"}
        ]
      },
      {
        "id": 11,
        "title": "HPA Metrics",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "kube_hpa_status_current_replicas{namespace=~\"ollamamax.*\"}",
            "legendFormat": "{{hpa}} - Current"
          },
          {
            "expr": "kube_hpa_status_desired_replicas{namespace=~\"ollamamax.*\"}",
            "legendFormat": "{{hpa}} - Desired"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Replicas"},
          {"format": "short"}
        ]
      },
      {
        "id": 12,
        "title": "Load Balancer Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36},
        "targets": [
          {
            "expr": "sum by (backend) (rate(nginx_http_requests_total{job=\"nginx\"}[5m]))",
            "legendFormat": "{{backend}}"
          }
        ]
      },
      {
        "id": 13,
        "title": "Security Events",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 44},
        "targets": [
          {
            "expr": "rate(security_events_total[5m])",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "indexByName": {"type": 0, "severity": 1, "Value": 2},
              "renameByName": {"type": "Event Type", "severity": "Severity", "Value": "Count"}
            }
          }
        ]
      },
      {
        "id": 14,
        "title": "Deployment Timeline",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 44},
        "targets": [
          {
            "expr": "deployment_event{environment=\"production\"}",
            "legendFormat": "{{event_type}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Events"},
          {"format": "short"}
        ],
        "legend": {"show": true, "alignAsTable": true, "rightSide": false}
      },
      {
        "id": 15,
        "title": "Database Connections",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 52},
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname=\"ollamamax\"}",
            "legendFormat": "Active Connections"
          },
          {
            "expr": "pg_settings_max_connections",
            "legendFormat": "Max Connections"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Connections"},
          {"format": "short"}
        ],
        "thresholds": [
          {"value": 100, "colorMode": "custom", "fill": false, "line": true, "op": "gt", "lineColor": "yellow"}
        ]
      },
      {
        "id": 16,
        "title": "Redis Operations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 52},
        "targets": [
          {
            "expr": "rate(redis_commands_processed_total[5m])",
            "legendFormat": "Commands/sec"
          },
          {
            "expr": "redis_connected_clients",
            "legendFormat": "Connected Clients"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Operations"},
          {"format": "short"}
        ]
      },
      {
        "id": 17,
        "title": "Rollback Events",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 60},
        "targets": [
          {
            "expr": "sum(increase(deployment_rollback_total{environment=\"production\"}[24h]))",
            "legendFormat": "Rollbacks (24h)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 3}
              ]
            }
          }
        }
      },
      {
        "id": 18,
        "title": "Alerts Active",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 60},
        "targets": [
          {
            "expr": "count(ALERTS{alertstate=\"firing\"})",
            "legendFormat": "Active Alerts"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "query",
          "query": "label_values(up, environment)",
          "current": {"text": "production", "value": "production"},
          "hide": 0,
          "includeAll": false,
          "multi": false,
          "options": [],
          "refresh": 1,
          "regex": "",
          "sort": 0
        },
        {
          "name": "namespace",
          "type": "query",
          "query": "label_values(kube_pod_info, namespace)",
          "current": {"text": "All", "value": "$__all"},
          "hide": 0,
          "includeAll": true,
          "multi": true,
          "options": [],
          "refresh": 1,
          "regex": "ollamamax.*",
          "sort": 0
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "deployment_event{environment=\"$environment\"}",
          "iconColor": "blue",
          "name": "Deployments",
          "tagKeys": "event_type",
          "titleFormat": "Deployment"
        },
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "deployment_rollback_total{environment=\"$environment\"}",
          "iconColor": "red",
          "name": "Rollbacks",
          "titleFormat": "Rollback"
        }
      ]
    },
    "time": {"from": "now-6h", "to": "now"},
    "timepicker": {
      "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}
