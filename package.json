{
  "name": "ollamamax",
  "version": "1.0.0",
  "description": "Enterprise-Grade Distributed AI Model Platform",
  "main": "index.js",
  "bin": {
    "claude-flow": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:watch": "nodemon --watch src --watch api-server src/server.js",
    "analyze": "node src/cli.js analyze",
    "analyse": "node src/cli.js analyse",
    "openrouter:test": "node -e 'const {OpenRouterClient} = require(\"./pkg/openrouter/client.js\"); const client = new OpenRouterClient(); client.health().then(() => console.log(\"OpenRouter connection successful\")).catch(console.error)'",
    "openrouter:models": "node -e 'const {OpenRouterClient} = require(\"./pkg/openrouter/client.js\"); const client = new OpenRouterClient(); client.getModels().then(models => console.log(JSON.stringify(models, null, 2))).catch(console.error)'",
    "build": "go build -o bin/ollamamax .",
    "test": "jest --config=jest.config.cjs",
    "test:auth": "jest tests/auth.test.js --config=jest.config.cjs",
    "test:api": "npx playwright test tests/api-health-tests.js",
    "test:integration": "jest tests/integration --config=jest.config.cjs",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:e2e:ui-only": "BACKEND_UP=0 bash scripts/run-e2e.sh",
    "test:e2e:api": "API_BASE_URL=${API_BASE_URL:-http://localhost:11434} BACKEND_UP=1 bash scripts/run-e2e.sh",
    "test:playwright": "npx playwright test",
    "test:load": "node tests/load-test.js",
    "test:security": "npm audit && node tests/security-scan.js",
    "test:all": "npm run test && node scripts/test-all-fixes.cjs",
    "test:all:sequential": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:performance",
    "test:all:parallel": "concurrently \"npm run test:unit\" \"npm run test:integration\"",
    "test:comprehensive": "npx playwright test tests/comprehensive-test-strategy.js",
    "test:agents": "jest tests/agent-system.test.cjs --config=jest.config.cjs",
    "test:fixes": "jest tests/comprehensive-test-suite.test.cjs --config=jest.config.cjs",
    "test:unit": "jest --config=jest.config.cjs",
    "test:watch": "jest --watch --config=jest.config.cjs",
    "test:coverage": "jest --coverage --config=jest.config.cjs",
    "test:coverage:check": "jest --coverage --config=jest.config.cjs && npm run validate:coverage",
    "test:coverage:report": "jest --coverage --config=jest.config.cjs && open coverage/lcov-report/index.html",
    "test:coverage:ci": "jest --coverage --coverageReporters=json --coverageReporters=lcov --config=jest.config.cjs && npm run validate:coverage",
    "test:quick:coverage": "jest --coverage --maxWorkers=4 --config=jest.config.cjs",
    "validate:coverage": "node scripts/validate-coverage.js",
    "validate:tests": "npm run test:all:sequential && npm run validate:coverage",
    "validate:ci": "npm run lint && npm run test:coverage:ci",
    "test:playwright": "npx playwright test",
    "test:ui": "npx playwright test tests/ui-interaction-tests.js",
    "test:p2p": "npx playwright test tests/p2p-model-migration-tests.js",
    "test:quick": "node tests/run-comprehensive-tests.js quick",
    "test:p2p-only": "node tests/run-comprehensive-tests.js p2p",
    "test:full": "node tests/run-comprehensive-tests.js full",
    "test:cross-browser": "node tests/run-comprehensive-tests.js crossBrowser",
    "test:performance": "npx playwright test --config=playwright.performance.config.js",
    "test:performance:comprehensive": "npx playwright test tests/performance-comprehensive.test.js --config=playwright.performance.config.js",
    "test:performance:stress": "npx playwright test tests/performance-stress.test.js --config=playwright.performance.config.js",
    "test:performance:monitoring": "npx playwright test tests/performance-monitoring.test.js --config=playwright.performance.config.js",
    "test:performance:all": "node tests/run-performance-tests.js",
    "test:performance:report": "node tests/performance-analysis-report.js",
    "test:show-report": "npx playwright show-report",
    "lint": "eslint src/ api-server/ tests/ --ext .js --fix",
    "lint:go": "golangci-lint run",
    "format": "prettier --write 'src/**/*.js' 'api-server/**/*.js' 'tests/**/*.js'",
    "go:dev": "go run .",
    "validate": "npm run test && npm run lint",
    "sprint:1:start": "npm run dev",
    "sprint:1:test": "npm run test:auth && npm run test:api",
    "sprint:1:complete": "npm run test && npm run lint && npm run test:e2e",
    "build:distributed": "cd ollama-distributed && go build -o bin/ollama-distributed ./cmd/distributed-ollama",
    "test:distributed": "cd ollama-distributed && go test ./... -v",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "deploy:backend": "docker-compose -f docker-compose.backend.yml up -d",
    "smart-agents": "node .claude-flow/commands/smart-agents/index.js",
    "agents": "./smart-agents",
    "agents:status": "node .claude-flow/commands/smart-agents/index.js status",
    "agents:test": "node .claude-flow/commands/smart-agents/test-runner.js",
    "agents:spawn": "node src/agents/claude-flow-integration.js spawn",
    "agents:orchestrate": "node src/agents/claude-flow-integration.js orchestrate",
    "agents:list": "node src/agents/claude-flow-integration.js list",
    "agents:integration": "node src/agents/claude-flow-integration.js",
    "help": "node src/cli.js help",
    "codebuff:help": "node src/cli.js help",
    "test:training": "bash scripts/run-training-tests.sh",
    "test:training:modules": "cd tests/training && go test -v -run TestTrainingModule ./...",
    "test:training:performance": "cd tests/training && go test -bench=. -benchmem ./...",
    "test:training:certification": "cd tests/training && go test -v -run TestCertification ./...",
    "test:training:validation": "bash tests/training/validation_scripts_enhanced.sh full",
    "training:metrics": "bash scripts/generate-training-metrics.sh",
    "training:dashboard": "bash scripts/generate-training-dashboard.sh",
    "training:report": "npm run training:metrics && npm run training:dashboard",
    "test:training:all": "npm run test:training && npm run training:report",
    "validate:training": "npm run test:training:all && npm run validate:coverage && bash -c 'if [ -f test-results/training/training-coverage.out ]; then COV=$(go tool cover -func=test-results/training/training-coverage.out | grep total | awk \"{print \\$3}\" | sed \"s/%//\"); if [ \"${COV%.*}\" -lt 90 ] 2>/dev/null; then echo \"⚠️ Training coverage ${COV}% below 90% target\"; else echo \"✅ Training coverage ${COV}% meets target\"; fi; else echo \"⚠️ Training coverage file not found\"; fi'",
    "deploy:validate:docker": "bash scripts/validate-docker-deployment.sh",
    "deploy:validate:k8s": "bash scripts/validate-k8s-deployment.sh",
    "deploy:validate:all": "bash scripts/run-deployment-validation.sh",
    "deploy:test:multiregion": "bash scripts/simulate-multi-region.sh",
    "deploy:test:autoscaling": "bash scripts/test-autoscaling.sh",
    "deploy:test:loadbalancing": "bash scripts/test-load-balancing.sh",
    "deploy:test:rollback": "bash scripts/test-rollback.sh",
    "deploy:validate:security": "bash scripts/validate-security.sh",
    "deploy:scan:vulnerabilities": "trivy fs . && snyk test",
    "deploy:scan:docker": "trivy image ollamamax:latest",
    "deploy:docker:dev": "bash deploy-docker.sh --dev",
    "deploy:docker:prod": "bash deploy-docker.sh --prod",
    "deploy:k8s:sprint1": "bash scripts/deploy-sprint1.sh",
    "deploy:k8s:sprint2": "bash scripts/deploy-sprint2.sh",
    "deploy:neural": "bash scripts/deploy-neural-training.sh",
    "deploy:validate:neural": "bash scripts/validate-neural-training.sh",
    "deploy:health:check": "bash ollama-distributed/scripts/health-check.sh",
    "deploy:smoke:test": "go test ./ollama-distributed/tests/smoke/...",
    "neural:train": "node src/agents/unified-neural-orchestrator.js train",
    "neural:train:agent-lstm": "AGENT_ID=${AGENT_ID:-agent_001} node src/agents/agent-lstm-predictor.js train",
    "neural:train:patterns": "node src/agents/neural-pattern-trainer.js train",
    "neural:train:algorithms": "node src/agents/swarm-algorithm-optimizer.js train",
    "neural:predict:agent": "AGENT_ID=${AGENT_ID:-agent_001} TASK_TYPE=${TASK_TYPE:-general} node src/agents/agent-performance-forecaster.js predict",
    "neural:predict:load": "AGENT_ID=${AGENT_ID:-agent_001} node src/agents/agent-lstm-predictor.js predict",
    "neural:predict:patterns": "node src/agents/neural-pattern-trainer.js predict",
    "neural:aggregate": "node src/agents/historical-data-aggregator.js aggregate",
    "neural:sync": "node src/agents/historical-data-aggregator.js sync",
    "neural:status": "node src/agents/unified-neural-orchestrator.js status",
    "neural:metrics": "node src/agents/unified-neural-orchestrator.js metrics",
    "test:neural": "node tests/ml/test-neural-training.js",
    "test:neural:integration": "jest tests/ml/test-neural-integration.js --config=jest.config.cjs",
    "validate:final": "bash scripts/run-final-validation.sh",
    "validate:e2e": "bash scripts/run-e2e-integration-tests.sh",
    "validate:load": "bash scripts/run-load-test-distributed.sh",
    "validate:chaos": "bash scripts/execute-chaos-engineering.sh",
    "validate:security": "bash scripts/execute-penetration-tests.sh",
    "validate:dr": "bash scripts/validate-disaster-recovery.sh",
    "validate:quick": "npm run validate:e2e && npm run validate:security",
    "validate:performance": "npm run validate:load",
    "validate:reliability": "npm run validate:chaos && npm run validate:dr",
    "report:final": "bash scripts/generate-final-production-report.sh",
    "report:issues": "echo 'See KNOWN_ISSUES.md for current issues and mitigations'"
  },
  "postinstall": "echo 'Validation scripts ready. Run npm run validate:final for production readiness assessment.'",
  "keywords": [
    "ai",
    "ollama",
    "distributed",
    "kubernetes",
    "microservices"
  ],
  "author": "OllamaMax Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "claude-flow": "^2.0.0-alpha.86",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/khryptorgraphics/ollamamax.git"
  },
  "bugs": {
    "url": "https://github.com/khryptorgraphics/ollamamax/issues"
  },
  "homepage": "https://github.com/khryptorgraphics/ollamamax#readme",
  "dependencies": {
    "@codebuff/sdk": "^0.1.29",
    "axios": "^1.12.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "bull": "^4.16.5",
    "chalk": "^5.6.0",
    "compression": "^1.8.1",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "playwright": "^1.55.0",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "redis": "^5.8.2",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "test": "^3.3.0",
    "winston": "^3.11.0",
    "yamljs": "^0.3.0"
  }
}
