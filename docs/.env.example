# OllamaMax Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# SECURITY - JWT & Authentication (REQUIRED)
# ============================================================================
# CRITICAL: These must be set for security. Use strong random values in production
# Generate secure keys: openssl rand -base64 32

JWT_SECRET_KEY=your-secret-key-change-this-in-production
# Alternative key name (JWT_SECRET is also supported for backward compatibility)
# JWT_SECRET=your-secret-key-change-this-in-production

AUTH_SECRET_KEY=your-auth-secret-change-this-in-production

# Authentication settings
AUTH_ENABLED=true
AUTH_METHOD=jwt

# ============================================================================
# SECURITY FIX (ISSUE-006): CORS Configuration
# ============================================================================
# Restrict CORS to specific allowed origins (comma-separated list)
# NEVER use "*" in production - specify exact origins
# Default: localhost for development only

CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# ============================================================================
# SECURITY FIX (ISSUE-007): Rate Limiting Configuration
# ============================================================================
# General API rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100        # General API requests per minute
RATE_LIMIT_BURST=10            # Burst allowance

# Authentication endpoint rate limits (per IP address, per minute)
# These protect against brute force attacks
RATE_LIMIT_LOGIN_REQUESTS=5             # Login attempts per minute (default: 5)
RATE_LIMIT_REGISTER_REQUESTS=3          # Registration attempts per minute (default: 3)
RATE_LIMIT_RESET_PASSWORD_REQUESTS=3    # Password reset attempts per minute (default: 3)

# ============================================================================
# API Server Configuration
# ============================================================================
API_LISTEN=0.0.0.0:11434
API_LISTEN_ADDR=0.0.0.0
API_PORT=11434
API_MAX_BODY_SIZE=33554432     # 32MB in bytes

# TLS/SSL Configuration (optional, recommended for production)
API_TLS_ENABLED=false
API_CERT_FILE=/path/to/cert.pem
API_KEY_FILE=/path/to/key.pem

# ============================================================================
# PERFORMANCE FIX (ISSUE-009): Database Connection Pool
# ============================================================================
# PostgreSQL Configuration
OLLAMA_DB_HOST=localhost
OLLAMA_DB_PORT=5432
OLLAMA_DB_NAME=ollamamax
OLLAMA_DB_USER=ollamamax
OLLAMA_DB_PASSWORD=your-db-password-here
OLLAMA_DB_SSL_MODE=prefer

# Connection Pool Settings (Production-optimized defaults)
# INCREASED for better scalability: supports 10,000+ RPS
OLLAMA_DB_MAX_OPEN_CONNS=100           # Maximum open connections (default: 100, was: 25)
OLLAMA_DB_MAX_IDLE_CONNS=20            # Maximum idle connections (default: 20, was: 10)
OLLAMA_DB_CONN_MAX_LIFETIME=300s       # Connection max lifetime (default: 5 minutes)

# ============================================================================
# Redis Configuration
# ============================================================================
OLLAMA_REDIS_HOST=localhost
OLLAMA_REDIS_PORT=6379
OLLAMA_REDIS_PASSWORD=
OLLAMA_REDIS_DB=0

# Redis Connection Pool
OLLAMA_REDIS_POOL_SIZE=10              # Connection pool size (default: 10)
OLLAMA_REDIS_MIN_IDLE_CONNS=5          # Minimum idle connections (default: 5)
OLLAMA_REDIS_DIAL_TIMEOUT=5s           # Connection timeout (default: 5s)
OLLAMA_REDIS_READ_TIMEOUT=3s           # Read timeout (default: 3s)
OLLAMA_REDIS_WRITE_TIMEOUT=3s          # Write timeout (default: 3s)

# ============================================================================
# P2P Network Configuration
# ============================================================================
P2P_LISTEN_ADDR=/ip4/0.0.0.0/tcp/0
P2P_MAX_CONNECTIONS=100

# ============================================================================
# Logging & Monitoring
# ============================================================================
LOG_LEVEL=info                          # debug, info, warn, error
LOG_FORMAT=json                         # json, text

# ============================================================================
# Development vs Production
# ============================================================================
# Set to 'production' for production deployments
ENVIRONMENT=development

# ============================================================================
# Example Production Configuration
# ============================================================================
# For production, use these settings:
#
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com
# RATE_LIMIT_LOGIN_REQUESTS=5
# RATE_LIMIT_REGISTER_REQUESTS=2
# API_TLS_ENABLED=true
# OLLAMA_DB_MAX_OPEN_CONNS=200
# OLLAMA_DB_MAX_IDLE_CONNS=50
# ENVIRONMENT=production
